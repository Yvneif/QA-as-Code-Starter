# Copy to .env for local overrides (`cp .env.example .env`).
# Every value here is a safe default the suite already falls back to in code —
# .env exists to demonstrate per-environment configuration without touching the repo.

# Application under test. Point this elsewhere to retarget the whole suite.
BASE_URL=https://www.saucedemo.com

# Demo credentials — published by the demo site itself, so they are not secrets.
# For a real application: keep real values in GitHub Actions secrets / a vault,
# reference them in CI, and NEVER commit them here or to .env.
DEMO_USERNAME=standard_user
DEMO_PASSWORD=secret_sauce
DEMO_LOCKED_USERNAME=locked_out_user
DEMO_LOCKED_PASSWORD=secret_sauce
